{
  "name": "scv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/skins/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace packages/cli",
    "build": "tsc -b && npm run build --workspace packages/ui",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-python@0.25.0": true,
    "tree-sitter-typescript@0.23.2": true,
    "tree-sitter@0.25.1": true,
    "better-sqlite3@11.10.0": true
  }
}
