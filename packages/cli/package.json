{
  "name": "semviz",
  "version": "0.1.0",
  "description": "scv: extract, narrate and diff a repo's semantics into scv/1 snapshots, with a committed .scv/semantics/ store and agent skills.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcgirish/semantic_viz.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "scv": "./dist/bin.js",
    "semviz": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-skills.mjs",
    "dev": "tsx src/bin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@semviz/differ": "^0.1.0",
    "@semviz/extractor": "^0.1.0",
    "@semviz/interpreter": "^0.1.0",
    "@semviz/schema": "^0.1.0",
    "commander": "^12.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.16.0"
  }
}
