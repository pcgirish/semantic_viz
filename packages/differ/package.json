{
  "name": "@semviz/differ",
  "version": "0.1.0",
  "description": "Diffs two semviz snapshots into a ranked scv-delta/1 inspect queue.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcgirish/semantic_viz.git",
    "directory": "packages/differ"
  },
  "type": "module",
