{
  "name": "@semviz/viewer",
  "version": "0.1.0",
  "description": "Local web viewer for semviz snapshots: scv-viewer serve (JSON API) and scv-viewer ui (prebuilt SPA).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcgirish/semantic_viz.git",
    "directory": "packages/viewer"
  },
  "type": "module",
  "bin": {
    "scv-viewer": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && node scripts/bundle.mjs",
    "dev": "tsx src/bin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.0",
    "@fastify/static": "^10.1.3",
    "@semviz/schema": "^0.1.0",
    "commander": "^12.0.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@semviz/server": "*",
    "@semviz/ui": "*",
    "@types/node": "^26.1.2",
    "esbuild": "^0.21.5",
    "tsx": "^4.16.0"
  }
}
